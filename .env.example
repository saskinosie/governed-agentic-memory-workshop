# Weaviate Local Configuration (Docker)
# Start Weaviate with: docker compose up -d
WEAVIATE_URL=http://localhost:8080
WEAVIATE_GRPC_PORT=50051

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Fallback mode. Set to 1 to run Weaviate Embedded in-process instead of Docker.
# Use this only if Docker will not start on your machine. See README, Fallback options.
USE_EMBEDDED_WEAVIATE=0
