# Copy this file to .env. Nothing here is secret unless you are on the cloud tier.

# Which Weaviate you are talking to. This is the one variable that switches tiers.
#   docker    local container, started with: docker compose up -d   (primary)
#   embedded  in-process Weaviate, no Docker, Mac and Linux only     (fallback)
#   cloud     your own free Weaviate Cloud sandbox (the floor)
WEAVIATE_MODE=docker

# Tier 1, docker. Defaults match docker-compose.yml.
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080
WEAVIATE_GRPC_PORT=50051

# Tier 3, cloud. Create a free sandbox at https://console.weaviate.cloud and paste its REST URL and API key.
WEAVIATE_CLOUD_URL=
WEAVIATE_CLOUD_KEY=

# Your handle. It prefixes your collection (ATTENDEE_HANDLE=ada gives Ada_MemoryRecord)
# and keeps your output labeled in the room. Required on the cloud tier. Letters and digits only.
ATTENDEE_HANDLE=

# Embedding model, loaded locally with sentence-transformers. No API key.
# The workshop texts also ship pre-embedded in data/vector_cache.json, so the
# core path works even if the model download fails.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
